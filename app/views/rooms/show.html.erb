<% content_for :title, "Room Details" %>

<section class="section">
  <div class="container">
    <div class="level mb-5">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Room Details</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <%= link_to rooms_path, class: "button is-light" do %>
            <span class="icon">
              <i class="fas fa-arrow-left"></i>
            </span>
            <span>Back to Rooms</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card">
      <header class="card-header">
        <p class="card-header-title">
          <span class="icon-text">
            <span class="icon">
              <i class="fas fa-door-open"></i>
            </span>
            <span><%= @room.name %></span>
          </span>
        </p>
      </header>
      <div class="card-content">
        <div class="content">
          <p class="has-text-weight-bold">Name: <%= @room.name %></p>
        </div>
      </div>
      <footer class="card-footer">
        <% if current_person&.is_a?(Dean) %>
          <%= link_to edit_room_path(@room), class: "card-footer-item" do %>
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-edit"></i>
              </span>
              <span>Edit</span>
            </span>
          <% end %>
          
          <%= button_to room_path(@room), method: :delete, class: "card-footer-item button is-white has-text-danger", data: { turbo_confirm: "Are you sure you want to delete this room?" } do %>
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-trash"></i>
              </span>
              <span>Delete</span>
            </span>
          <% end %>
        <% end %>
      </footer>
    </div>

    <% if current_person&.is_a?(Dean) %>
      <div class="mt-5">
        <h2 class="subtitle">Courses Scheduled in This Room</h2>
        <% school_classes = SchoolClass.where(room_id: @room.id) %>
        <% courses = Course.where(school_class_id: school_classes.pluck(:id)) %>
        
        <% if courses.any? %>
          <div class="table-container">
            <table class="table is-fullwidth is-hoverable">
              <thead>
                <tr>
                  <th>Subject</th>
                  <th>Class</th>
                  <th>Teacher</th>
                  <th>Schedule</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% courses.each do |course| %>
                  <tr>
                    <td><%= course.subject&.name || "Unknown subject" %></td>
                    <td><%= course.school_class&.name || "Unknown class" %></td>
                    <td><%= course.person&.full_name || "No teacher assigned" %></td>
                    <td>
                      <span class="icon-text">
                        <span class="icon">
                          <i class="fas fa-calendar-day"></i>
                        </span>
                        <span>
                          <%= [
                            ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][course.week_day],
                            course.start_at&.strftime("%H:%M"),
                            course.end_at&.strftime("%H:%M")
                          ].compact.join(" | ") %>
                        </span>
                      </span>
                    </td>
                    <td>
                      <div class="buttons are-small">
                        <%= link_to course_path(course), class: "button is-info" do %>
                          <span class="icon">
                            <i class="fas fa-eye"></i>
                          </span>
                          <span>View</span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="notification is-info is-light">
            <p>No courses are currently scheduled in this room.</p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
