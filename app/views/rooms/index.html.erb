<% content_for :title, "Rooms" %>

<section class="section">
  <div class="container">
    <div class="level mb-5">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Rooms</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <% if current_person&.is_a?(Dean) %>
            <%= link_to new_room_path, class: "button is-primary" do %>
              <span class="icon">
                <i class="fas fa-plus"></i>
              </span>
              <span>New Room</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <% if @rooms.any? %>
      <div class="card">
        <header class="card-header">
          <p class="card-header-title">
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-door-open"></i>
              </span>
              <span>All Rooms</span>
            </span>
          </p>
        </header>
        <div class="card-content">
          <div class="table-container">
            <table class="table is-fullwidth is-hoverable">
              <thead>
                <tr>
                  <th>Room Name</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @rooms.each do |room| %>
                  <tr>
                    <td><%= room.name %></td>
                    <td>
                      <div class="buttons are-small">
                        <%= link_to room_path(room), class: "button is-info" do %>
                          <span class="icon">
                            <i class="fas fa-eye"></i>
                          </span>
                          <span>View</span>
                        <% end %>
                        
                        <% if current_person&.is_a?(Dean) %>
                          <%= link_to edit_room_path(room), class: "button is-link" do %>
                            <span class="icon">
                              <i class="fas fa-edit"></i>
                            </span>
                            <span>Edit</span>
                          <% end %>
                          
                          <%= button_to room_path(room), method: :delete, class: "button is-danger", form: { style: "display: inline;" }, data: { turbo_confirm: "Are you sure you want to delete this room?" } do %>
                            <span class="icon">
                              <i class="fas fa-trash"></i>
                            </span>
                            <span>Delete</span>
                          <% end %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% else %>
      <div class="notification is-info is-light">
        <p>No rooms have been created yet.</p>
      </div>
    <% end %>
  </div>
</section>
