<% content_for :title, "Grade Details" %>

<section class="section">
  <div class="container">
    <div class="level mb-5">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Grade Details</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <%= link_to grades_path, class: "button is-light" do %>
            <span class="icon">
              <i class="fas fa-arrow-left"></i>
            </span>
            <span>Back to Grades</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card">
      <header class="card-header">
        <p class="card-header-title">
          <span class="icon-text">
            <span class="icon">
              <i class="fas fa-award"></i>
            </span>
            <span>Grade: <%= @grade.value %></span>
          </span>
        </p>
      </header>
      <div class="card-content">
        <div class="content">
          <div class="columns is-multiline">
            <div class="column is-6">
              <p class="has-text-weight-bold">Student:</p>
              <p><%= @grade.person&.full_name || "No student assigned" %><%= @grade.person ? " (#{@grade.person.email})" : "" %></p>
            </div>
            <div class="column is-6">
              <p class="has-text-weight-bold">Value:</p>
              <p><%= @grade.value %></p>
            </div>
            <div class="column is-6">
              <p class="has-text-weight-bold">Examination:</p>
              <p><%= @grade.examination&.title || "Unknown examination" %></p>
            </div>
            <div class="column is-6">
              <p class="has-text-weight-bold">Subject:</p>
              <p><%= @grade.examination&.course&.subject&.name || "Unknown subject" %></p>
            </div>
            <div class="column is-6">
              <p class="has-text-weight-bold">Expected at:</p>
              <p><%= @grade.expected_at&.strftime("%Y-%m-%d") || "Not set" %></p>
            </div>
            <div class="column is-6">
              <p class="has-text-weight-bold">Class:</p>
              <p><%= @grade.examination&.course&.school_class&.name || "Unknown class" %></p>
            </div>
          </div>
        </div>
      </div>
      <footer class="card-footer">
        <% if current_person.is_a?(Teacher) || current_person.is_a?(Dean) %>
          <%= link_to edit_grade_path(@grade), class: "card-footer-item" do %>
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-edit"></i>
              </span>
              <span>Edit</span>
            </span>
          <% end %>
          
          <%= button_to grade_path(@grade), method: :delete, class: "card-footer-item button is-white has-text-danger", data: { turbo_confirm: "Are you sure you want to delete this grade?" } do %>
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-trash"></i>
              </span>
              <span>Delete</span>
            </span>
          <% end %>
        <% end %>
      </footer>
    </div>
  </div>
</section>
