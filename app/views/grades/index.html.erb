<% content_for :title, "Grades" %>

<section class="section">
  <div class="container">
    <% if notice.present? %>
      <div class="notification is-success is-light">
        <%= notice %>
      </div>
    <% end %>

    <div class="level mb-5">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">
            <% if @student %>
              Grades for <%= @student.full_name %>
            <% else %>
              Grades
            <% end %>
          </h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <% if current_person.is_a?(Teacher) && @student %>
            <%= link_to new_grade_path(student_id: @student.id), class: "button is-primary" do %>
              <span class="icon">
                <i class="fas fa-plus"></i>
              </span>
              <span>New Grade</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <% if @grades.any? %>
      <div class="card">
        <header class="card-header">
          <p class="card-header-title">
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-award"></i>
              </span>
              <span>All Grades</span>
            </span>
          </p>
        </header>
        <div class="card-content">
          <div class="table-container">
            <table class="table is-fullwidth is-hoverable">
              <thead>
                <tr>
                  <th>Student</th>
                  <th>Subject</th>
                  <th>Examination</th>
                  <th>Grade</th>
                  <th>Expected At</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @grades.each do |grade| %>
                  <tr>
                    <td><%= grade.person&.full_name || "No student assigned" %></td>
                    <td><%= grade.examination&.course&.subject&.name || "Unknown subject" %></td>
                    <td><%= grade.examination&.title || "Unknown examination" %></td>
                    <td><%= grade.value %></td>
                    <td><%= grade.expected_at&.strftime("%Y-%m-%d") %></td>
                    <td>
                      <div class="buttons are-small">
                        <%= link_to grade_path(grade), class: "button is-info" do %>
                          <span class="icon">
                            <i class="fas fa-eye"></i>
                          </span>
                          <span>View</span>
                        <% end %>
                        
                        <% if current_person.is_a?(Teacher) || current_person.is_a?(Dean) %>
                          <%= link_to edit_grade_path(grade), class: "button is-link" do %>
                            <span class="icon">
                              <i class="fas fa-edit"></i>
                            </span>
                            <span>Edit</span>
                          <% end %>
                          
                          <%= button_to grade_path(grade), method: :delete, class: "button is-danger", form: { style: "display: inline;" }, data: { turbo_confirm: "Are you sure you want to delete this grade?" } do %>
                            <span class="icon">
                              <i class="fas fa-trash"></i>
                            </span>
                            <span>Delete</span>
                          <% end %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% else %>
      <div class="notification is-info is-light">
        <p>No grades found.</p>
      </div>
    <% end %>

    <% if current_person.is_a?(Teacher) && @student %>
      <div class="mt-4">
        <%= link_to :back, class: "button is-light" do %>
          <span class="icon">
            <i class="fas fa-arrow-left"></i>
          </span>
          <span>Back</span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
