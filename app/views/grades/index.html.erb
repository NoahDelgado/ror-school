<% if notice.present? %>
  <div class="notification is-success is-light">
    <%= notice %>
  </div>
<% end %>

<% content_for :title, "Grades" %>

<div class="box">
  <h1 class="title is-2">
    <% if @student %>
      Grades for <%= @student.email %>
    <% else %>
      Grades
    <% end %>
  </h1>

  <div class="table-container">
    <table class="table is-striped is-hoverable is-fullwidth">
      <thead>
        <tr>
          <th>Student</th>
          <th>Subject</th>
          <th>Examination</th>
          <th>Grade</th>
          <th>Expected At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @grades.each do |grade| %>
          <tr>
            <td><%= grade.person.email %></td>
            <td><%= grade.examination.course.subject.name %></td>
            <td><%= grade.examination.title %></td>
            <td><%= grade.value %></td>
            <td><%= grade.expected_at&.strftime("%Y-%m-%d") %></td>
            <td>
              <div class="buttons are-small">
                <%= link_to "View", grade_path(grade), class: "button is-info" %>
                <% if current_person.is_a?(Teacher) %>
                  <%= link_to "Edit", edit_grade_path(grade), class: "button is-warning" %>
                  <%= button_to "Delete", grade_path(grade), method: :delete, class: "button is-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if current_person.is_a?(Teacher) && @student %>
    <div class="field mt-5">
      <%= link_to "New Grade", new_grade_path(student_id: @student.id), class: "button is-primary" %>
      <%= link_to "Back", :back, class: "button is-light" %>
    </div>
  <% end %>
</div>
