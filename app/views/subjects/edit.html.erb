<% content_for :title, "Edit Subject" %>

<section class="section">
  <div class="container">
    <div class="level mb-5">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Edit Subject</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <div class="buttons">
            <%= link_to subject_path(@subject), class: "button is-info" do %>
              <span class="icon">
                <i class="fas fa-eye"></i>
              </span>
              <span>View Subject</span>
            <% end %>
            <%= link_to subjects_path, class: "button is-light" do %>
              <span class="icon">
                <i class="fas fa-arrow-left"></i>
              </span>
              <span>Back to Subjects</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <header class="card-header">
        <p class="card-header-title">
          <span class="icon-text">
            <span class="icon">
              <i class="fas fa-edit"></i>
            </span>
            <span>Edit <%= @subject.name %></span>
          </span>
        </p>
      </header>
      <div class="card-content">
        <%= render "form", subject: @subject %>
      </div>
    </div>
  </div>
</section>
