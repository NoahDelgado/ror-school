<% content_for :title, "Manage Courses" %>

<section class="section">
  <div class="container">
    <div class="level">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Manage Courses</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <%= link_to dean_dashboard_index_path, class: "button is-light" do %>
            <span class="icon">
              <i class="fas fa-arrow-left"></i>
            </span>
            <span>Back to Dashboard</span>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Create Course Form -->
    <div class="box mb-6">
      <h2 class="title is-4 mb-4">Create New Course</h2>
      
      <%= form_with(model: Course.new, url: courses_path) do |form| %>
        <div class="columns is-multiline">
          <div class="column is-4">
            <div class="field">
              <%= form.label :subject_id, class: "label" %>
              <div class="control">
                <div class="select is-fullwidth">
                  <%= form.collection_select :subject_id, @subjects, :id, :name %>
                </div>
              </div>
            </div>
          </div>
          
          <div class="column is-4">
            <div class="field">
              <%= form.label :moment_id, class: "label" %>
              <div class="control">
                <div class="select is-fullwidth">
                  <%= form.collection_select :moment_id, @moments, :id, :display_name %>
                </div>
              </div>
            </div>
          </div>
          
          <div class="column is-4">
            <div class="field">
              <%= form.label :school_class_id, class: "label" %>
              <div class="control">
                <div class="select is-fullwidth">
                  <%= form.collection_select :school_class_id, @school_classes, :id, :name %>
                </div>
              </div>
            </div>
          </div>
          
          <div class="column is-4">
            <div class="field">
              <%= form.label :person_id, "Teacher", class: "label" %>
              <div class="control">
                <div class="select is-fullwidth">
                  <%= form.collection_select :person_id, @teachers, :id, :full_name, { selected: params[:teacher_id] } %>
                </div>
              </div>
            </div>
          </div>
          
          <div class="column is-3">
            <div class="field">
              <%= form.label :week_day, class: "label" %>
              <div class="control">
                <div class="select is-fullwidth">
                  <%= form.select :week_day, [["Monday", 1], ["Tuesday", 2], ["Wednesday", 3], 
                                             ["Thursday", 4], ["Friday", 5]] %>
                </div>
              </div>
            </div>
          </div>
          
          <div class="column is-2">
            <div class="field">
              <%= form.label :start_at, class: "label" %>
              <div class="control">
                <%= form.time_field :start_at, class: "input" %>
              </div>
              <p class="help">Enter time in HH:MM format</p>
            </div>
          </div>
          
          <div class="column is-2">
            <div class="field">
              <%= form.label :end_at, class: "label" %>
              <div class="control">
                <%= form.time_field :end_at, class: "input" %>
              </div>
              <p class="help">Enter time in HH:MM format</p>
            </div>
          </div>
          
          <div class="column is-12">
            <div class="field">
              <div class="control">
                <%= form.submit "Create Course", class: "button is-primary" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- All Courses -->
    <div class="card">
      <header class="card-header">
        <p class="card-header-title">
          <span class="icon-text">
            <span class="icon">
              <i class="fas fa-list"></i>
            </span>
            <span>All Courses</span>
          </span>
        </p>
      </header>
      <div class="card-content">
        <% if @courses.exists? %>
          <div class="table-container">
            <table class="table is-fullwidth is-hoverable">
              <thead>
                <tr>
                  <th>Subject</th>
                  <th>Moment</th>
                  <th>Class</th>
                  <th>Teacher</th>
                  <th>Schedule</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @courses.each do |course| %>
                  <tr>
                    <td><%= course.subject&.name || "Unknown subject" %></td>
                    <td><%= course.moment&.display_name || "Unknown period" %></td>
                    <td><%= course.school_class&.name || "Unknown class" %></td>
                    <td><%= course.person&.full_name || "No teacher assigned" %></td>
                    <td>
                      <span class="icon-text">
                        <span class="icon">
                          <i class="fas fa-calendar-day"></i>
                        </span>
                        <span>
                          <%= {
                            1 => "Monday",
                            2 => "Tuesday",
                            3 => "Wednesday",
                            4 => "Thursday",
                            5 => "Friday"
                          }[course.week_day] || "Unknown" %> | <%= course.start_at&.strftime("%H:%M") %> - <%= course.end_at&.strftime("%H:%M") %>
                        </span>
                      </span>
                    </td>
                    <td>
                      <div class="buttons are-small">
                        <%= link_to edit_course_path(course), class: "button is-link" do %>
                          <span class="icon">
                            <i class="fas fa-edit"></i>
                          </span>
                          <span>Edit</span>
                        <% end %>
                        <%= link_to course_path(course), 
                                  method: :delete, 
                                  data: { confirm: "Are you sure you want to delete this course?" }, 
                                  class: "button is-danger" do %>
                          <span class="icon">
                            <i class="fas fa-trash"></i>
                          </span>
                          <span>Delete</span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="notification is-light">
            <p>No courses available.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section> 