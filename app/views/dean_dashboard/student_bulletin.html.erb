<% content_for :title, "Student Grade Bulletin" %>

<section class="section">
  <div class="container">
    <div class="level">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Grade Bulletin</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <%= link_to manage_bulletins_dean_dashboard_index_path, class: "button" do %>
            <span class="icon">
              <i class="fas fa-arrow-left"></i>
            </span>
            <span>Back</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="box">
      <div class="columns">
        <div class="column">
          <h2 class="title is-4">Student Information</h2>
          <div class="content">
            <p><strong>Name:</strong> <%= @student.full_name %></p>
            <p><strong>Class:</strong> <%= @student.school_classes.map(&:name).join(", ") %></p>
            <p><strong>Period:</strong> <%= @moment.display_name %></p>
          </div>
        </div>
      </div>
    </div>

    <div class="box">
      <h2 class="title is-4">Grades</h2>
      
      <% if @grades.any? %>
        <div class="table-container">
          <table class="table is-fullwidth is-hoverable">
            <thead>
              <tr>
                <th>Subject</th>
                <th>Examination</th>
                <th>Grade</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% @grades.each do |grade| %>
                <tr>
                  <td><%= grade.examination.course.subject.name %></td>
                  <td><%= grade.examination.title %></td>
                  <td class="has-text-weight-bold"><%= grade.value %></td>
                  <td><%= grade.examination.expected_at.strftime('%d-%m-%Y') if grade.examination.expected_at %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr>
                <th colspan="2" class="has-text-right">Average Grade:</th>
                <th class="has-text-weight-bold">
                  <%= @grades.average(:value).round(2) rescue 'N/A' %>
                </th>
                <th></th>
              </tr>
            </tfoot>
          </table>
        </div>
      <% else %>
        <div class="notification is-warning">
          <p>No grades available for this student in the selected period.</p>
        </div>
      <% end %>
    </div>

    <div class="box">
      <div class="level">
        <div class="level-left">
          <div class="level-item">
            <p><strong>Date:</strong> <%= Date.today.strftime('%d-%m-%Y') %></p>
          </div>
        </div>
        <div class="level-right">
          <div class="level-item">
            <p><strong>Dean Signature:</strong> _________________________</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media print {
    .button, nav, footer {
      display: none !important;
    }
    
    .box {
      box-shadow: none !important;
      border: 1px solid #ddd !important;
      margin-bottom: 1rem !important;
    }
    
    body {
      font-size: 12pt !important;
    }
    
    .title {
      font-size: 14pt !important;
    }
    
    .table {
      border-collapse: collapse !important;
    }
    
    .table th, .table td {
      border: 1px solid #ddd !important;
    }
  }
</style> 