<div class="table-container">
  <% if courses.any? %>
    <table class="table is-fullwidth is-hoverable">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Class</th>
          <th>Teacher</th>
          <th>Schedule</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% courses.each do |course| %>
          <tr class="<%= course.deleted_at.present? ? 'has-background-warning-light' : '' %>">
            <td><%= course.subject&.name || "Unknown subject" %></td>
            <td><%= course.school_class&.name || "Unknown class" %></td>
            <td><%= course.person&.full_name || "No teacher assigned" %></td>
            <td>
              <span class="icon-text">
                <span class="icon">
                  <i class="fas fa-calendar-day"></i>
                </span>
                <span>
                  <%= [
                    ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][course.week_day],
                    course.start_at&.strftime("%H:%M"),
                    course.end_at&.strftime("%H:%M")
                  ].compact.join(" | ") %>
                </span>
              </span>
            </td>
            <td>
              <% if course.deleted_at.present? %>
                <span class="tag is-warning">Archived</span>
                <p class="help">on <%= course.deleted_at.strftime("%d %b %Y") %></p>
              <% else %>
                <span class="tag is-success">Active</span>
              <% end %>
            </td>
            <td>
              <div class="buttons are-small">
                <%= link_to course_path(course), class: "button is-info" do %>
                  <span class="icon">
                    <i class="fas fa-eye"></i>
                  </span>
                  <span>View</span>
                <% end %>
                
                <% if !course.deleted_at.present? %>
                  <%= link_to edit_course_path(course), class: "button is-link" do %>
                    <span class="icon">
                      <i class="fas fa-edit"></i>
                    </span>
                    <span>Edit</span>
                  <% end %>
                  
                  <%= button_to course_path(course), method: :delete, class: "button is-danger", form: { style: "display: inline;" }, data: { turbo_confirm: "Are you sure you want to archive this course?" } do %>
                    <span class="icon">
                      <i class="fas fa-archive"></i>
                    </span>
                    <span>Archive</span>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="notification is-info is-light">
      <p>No courses found.</p>
    </div>
  <% end %>
</div> 