<section class="section">
  <div class="container">
    <% if notice.present? %>
      <div class="notification is-success is-light">
        <%= notice %>
      </div>
    <% end %>

    <div class="level mb-5">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title is-2 mb-0"><%= @school_class.name %></h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <%= link_to "Back", school_classes_path, class: "button is-light" %>
          <% if current_person.is_a?(Dean) %>
            <%= link_to "Manage Students", manage_students_school_class_path(@school_class), class: "button is-success ml-2" %>
            <%= link_to "Edit", edit_school_class_path(@school_class), class: "button is-info ml-2" %>
            <%= button_to "Delete", school_class_path(@school_class), method: :delete, class: "button is-danger ml-2", form: { data: { turbo_confirm: "Are you sure?" } } %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="columns">
      <div class="column is-4">
        <div class="box">
          <h2 class="title is-4">Class Details</h2>
          <div class="content">
            <div class="field">
              <label class="label">UID</label>
              <p><%= @school_class.uid %></p>
            </div>

            <div class="field">
              <label class="label">Room</label>
              <p><%= @school_class.room.name %></p>
            </div>

            <div class="field">
              <label class="label">Section</label>
              <p><%= @school_class.section.name %></p>
            </div>
          </div>
        </div>
        
        <% if @students.any? %>
        <div class="box mt-4">
          <h2 class="title is-4">Students <span class="tag is-info ml-2"><%= @students.count %></span></h2>
          <div class="content">
            <% @students.each do |student| %>
              <div class="student-item mb-2 pb-2" style="border-bottom: 1px solid #f0f0f0;">
                <div class="is-flex is-justify-content-space-between">
                  <div>
                    <strong><%= student.full_name %></strong><br>
                    <small><%= student.email %></small>
                  </div>
                  <% if current_person.is_a?(Teacher) %>
                  <div>
                    <%= link_to "Grades", student_grades_path(student), class: "button is-small is-info" %>
                  </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <% end %>
      </div>

      <div class="column is-8">
        <% if current_person.is_a?(Teacher) && @courses.present? %>
          <div class="box">
            <h2 class="title is-4">My Courses</h2>
            <div class="table-container">
              <table class="table is-striped is-hoverable is-fullwidth">
                <thead>
                  <tr>
                    <th>Subject</th>
                    <th>Day</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @courses.each do |course| %>
                    <tr>
                      <td><%= course.subject.name %></td>
                      <td><%= format_week_day(course.week_day) %></td>
                      <td><%= course.start_at&.strftime("%H:%M") %></td>
                      <td><%= course.end_at&.strftime("%H:%M") %></td>
                      <td>
                        <%= link_to "View Examinations", course_examinations_path(course), class: "button is-small is-info" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
        
        <% if current_person.is_a?(Dean) || (current_person.is_a?(Teacher) && @courses.blank?) %>
          <div class="box">
            <h2 class="title is-4">All Courses</h2>
            <% if @school_class.courses.any? %>
              <div class="table-container">
                <table class="table is-striped is-hoverable is-fullwidth">
                  <thead>
                    <tr>
                      <th>Subject</th>
                      <th>Teacher</th>
                      <th>Day</th>
                      <th>Time</th>
                      <% if current_person.is_a?(Dean) %>
                        <th>Actions</th>
                      <% end %>
                    </tr>
                  </thead>
                  <tbody>
                    <% @school_class.courses.each do |course| %>
                      <tr>
                        <td><%= course.subject.name %></td>
                        <td><%= course.person.full_name %></td>
                        <td><%= format_week_day(course.week_day) %></td>
                        <td><%= course.start_at&.strftime("%H:%M") %> - <%= course.end_at&.strftime("%H:%M") %></td>
                        <% if current_person.is_a?(Dean) %>
                          <td>
                            <%= link_to "Edit", edit_course_path(course), class: "button is-small is-info" %>
                          </td>
                        <% end %>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <p class="has-text-centered mt-4">No courses have been assigned to this class yet.</p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
