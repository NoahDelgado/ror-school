<% content_for :title, "Edit School Class" %>

<section class="section">
  <div class="columns">
    <div class="column is-10 is-offset-1">
      <div class="level mb-5">
        <div class="level-left">
          <div class="level-item">
            <h1 class="title is-2">Edit School Class</h1>
          </div>
        </div>
        <div class="level-right">
          <div class="level-item">
            <div class="buttons">
              <%= link_to @school_class, class: "button is-info" do %>
                <span class="icon">
                  <i class="fas fa-eye"></i>
                </span>
                <span>View Class</span>
              <% end %>
              <%= link_to management_school_classes_path, class: "button" do %>
                <span class="icon">
                  <i class="fas fa-arrow-left"></i>
                </span>
                <span>Back to Management</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      
      <%= render "form", school_class: @school_class %>
    </div>
  </div>
</section>
