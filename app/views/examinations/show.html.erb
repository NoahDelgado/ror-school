<% content_for :title, @examination.title %>

<div class="box">
  <div class="level">
    <div class="level-left">
      <div class="level-item">
        <h1 class="title is-2"><%= @examination.title %></h1>
      </div>
    </div>
    <div class="level-right">
      <div class="level-item">
        <% if current_person.is_a?(Dean) || (current_person.is_a?(Teacher) && @examination.course.person_id == current_person.id) %>
          <%= link_to edit_examination_path(@examination), class: "button is-warning" do %>
            <span class="icon">
              <i class="fas fa-edit"></i>
            </span>
            <span>Edit Examination</span>
          <% end %>
          <%= button_to examination_path(@examination), method: :delete, class: "button is-danger", form: { data: { turbo_confirm: "Are you sure?" } } do %>
            <span class="icon">
              <i class="fas fa-trash"></i>
            </span>
            <span>Delete</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="content">
    <div class="columns">
      <div class="column is-4">
        <div class="field">
          <label class="label">Course</label>
          <p><%= @examination.course&.subject&.name || "Unknown subject" %> - <%= @examination.course&.school_class&.name || "Unknown class" %></p>
        </div>

        <div class="field">
          <label class="label">Expected Date</label>
          <p><%= @examination.expected_at&.strftime("%B %d, %Y") %></p>
        </div>

        <div class="field">
          <label class="label">Time</label>
          <p><%= @examination.expected_at&.strftime("%H:%M") %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<% if current_person.is_a?(Teacher) && @students.present? %>
  <div class="box mt-5">
    <h2 class="title is-3">Student Grades</h2>
    
    <%= form_with(model: @examination, url: update_grades_examination_path(@examination), method: :patch) do |f| %>
      <div class="table-container">
        <table class="table is-striped is-hoverable is-fullwidth">
          <thead>
            <tr>
              <th>Student</th>
              <th>Grade</th>
              <th>Expected At</th>
            </tr>
          </thead>
          <tbody>
            <% @students.each_with_index do |student, index| %>
              <tr>
                <td><%= student.full_name %></td>
                <td>
                  <div class="field">
                    <div class="control">
                      <%= f.fields_for :grades, @student_grades[index] do |grade_form| %>
                        <%= grade_form.hidden_field :person_id %>
                        <%= grade_form.number_field :value, 
                            class: "input", 
                            min: 1, 
                            max: 6, 
                            step: 0.5,
                            placeholder: "Enter grade (1-6)" %>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="field">
                    <div class="control">
                      <%= f.fields_for :grades, @student_grades[index] do |grade_form| %>
                        <%= grade_form.datetime_field :expected_at, class: "input" %>
                      <% end %>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="field mt-5">
        <%= f.submit "Save All Grades", class: "button is-primary" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mt-5">
  <%= link_to "Back to examinations", examinations_path, class: "button is-light" %>
</div>
