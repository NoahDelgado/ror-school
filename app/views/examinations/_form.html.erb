<%= form_with(model: examination) do |form| %>
  <% if examination.errors.any? %>
    <div class="notification is-danger">
      <h2><%= pluralize(examination.errors.count, "error") %> prohibited this examination from being saved:</h2>

      <ul>
        <% examination.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, class: "label" %>
    <div class="control">
      <%= form.text_field :title, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= form.label :expected_at, class: "label" %>
    <div class="control">
      <%= form.datetime_field :expected_at, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= form.label :course_id, "Course", class: "label" %>
    <div class="control">
      <%= form.collection_select :course_id,
          current_person.is_a?(Teacher) ? Course.where(person_id: current_person.id) : Course.all,
          :id,
          ->(c) { "#{c.subject.name} - #{c.school_class.name} (#{c.week_day})" },
          { prompt: "Select a course" },
          { class: "select" } %>
    </div>
  </div>

  <div class="field">
    <%= form.submit class: "button is-primary" %>
  </div>
<% end %>
