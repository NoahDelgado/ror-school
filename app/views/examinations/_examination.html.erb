<div id="<%= dom_id examination %>" class="card">
  <header class="card-header">
    <p class="card-header-title">
      <%= examination.title %>
    </p>
  </header>
  
  <div class="card-content">
    <div class="content">
      <div class="mb-3">
        <span class="icon-text">
          <span class="icon">
            <i class="fas fa-calendar"></i>
          </span>
          <span>
            <strong>Expected Date:</strong><br>
            <%= examination.expected_at&.strftime("%B %d, %Y") %>
          </span>
        </span>
      </div>

      <div class="mb-3">
        <span class="icon-text">
          <span class="icon">
            <i class="fas fa-clock"></i>
          </span>
          <span>
            <strong>Time:</strong><br>
            <%= examination.expected_at&.strftime("%H:%M") %>
          </span>
        </span>
      </div>

      <div class="mb-3">
        <span class="icon-text">
          <span class="icon">
            <i class="fas fa-book"></i>
          </span>
          <span>
            <strong>Course:</strong><br>
            <%= examination.course.subject.name %>
          </span>
        </span>
      </div>

      <div>
        <span class="icon-text">
          <span class="icon">
            <i class="fas fa-users"></i>
          </span>
          <span>
            <strong>Class:</strong><br>
            <%= examination.course.school_class.name %>
          </span>
        </span>
      </div>
    </div>
  </div>

  <footer class="card-footer">
    <%= link_to "View Details", examination, class: "card-footer-item" %>
    <% if current_person.is_a?(Dean) || (current_person.is_a?(Teacher) && examination.course.person_id == current_person.id) %>
      <%= link_to "Edit", edit_examination_path(examination), class: "card-footer-item" %>
      <%= link_to "Delete", examination, class: "card-footer-item has-text-danger", 
          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this examination?" } %>
    <% end %>
  </footer>
</div>
