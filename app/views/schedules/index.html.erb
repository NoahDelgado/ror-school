<% content_for :head do %>
  <style>
    /* Override the default container for schedule page */
    body.schedule-page main.container {
      max-width: 100%;
      padding: 0;
      margin: 3.5rem 1rem 1rem 1rem;
      background-color: transparent;
      box-shadow: none;
    }
    
    @media (min-width: 1200px) {
      body.schedule-page main.container {
        max-width: 1400px;
        margin-left: auto;
        margin-right: auto;
      }
    }

    /* Timetable general styling */
    .timetable-container {
      overflow-x: auto;
    }
    
    .timetable {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    
    .timetable th, .timetable td {
      border: 1px solid #e0e0e0;
    }
    
    .time-column {
      width: 60px;
    }
    
    .day-column {
      width: calc((100% - 60px) / 5);
      padding: 6px 0;
      font-size: 0.85rem;
    }
    
    /* Improved styling for course blocks */
    .day-cell {
      position: relative;
      height: 60px;
      vertical-align: top;
      padding: 0 !important;
      background-color: rgba(240, 240, 240, 0.3);
    }
    
    .course-block {
      color: white;
      border-radius: 6px;
      padding: 8px;
      margin: 2px;
      font-size: 0.75rem;
      height: calc(100% - 4px);
      overflow: hidden;
      box-shadow: 0 1px 2px rgba(10, 10, 10, 0.1);
      display: flex;
      flex-direction: column;
      min-height: 52px;
    }
    
    .course-block:hover {
      transform: scale(1.02);
      box-shadow: 0 4px 6px rgba(10, 10, 10, 0.15);
      z-index: 10;
    }
    
    /* When multiple courses are in the same cell */
    .day-cell .course-block {
      height: calc(100% - 4px);
    }
    
    .day-cell .course-block:not(:only-child) {
      height: calc(50% - 3px);
    }
    
    .day-cell .course-block:first-child:nth-last-child(3),
    .day-cell .course-block:first-child:nth-last-child(3) ~ .course-block {
      height: calc(33.333% - 3px);
      margin-bottom: 1px;
    }
    
    .course-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      font-size: 0.7rem;
      margin-bottom: 3px;
    }
    
    .course-content {
      display: flex;
      justify-content: space-between;
      flex-grow: 1;
    }
    
    .course-left {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    
    .course-right {
      text-align: right;
      font-size: 0.7rem;
      font-weight: bold;
      align-self: flex-start;
      padding-left: 4px;
      background-color: rgba(255, 255, 255, 0.2);
      border-radius: 3px;
      padding: 1px 4px;
      margin-left: 4px;
    }
    
    .course-name {
      font-weight: bold;
      font-size: 0.85rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 2px;
    }
    
    .course-location {
      font-size: 0.7rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    
    .time-cell {
      text-align: center;
      font-weight: bold;
      color: #444;
      background-color: #f5f5f5;
      font-size: 0.75rem;
      padding: 2px !important;
    }
    
    /* Styling for column headers */
    .day-column {
      text-align: center;
      background-color: #3273dc;
      color: white;
      padding: 10px 0;
    }

    /* Additional styles for the schedule container */
    .schedule-container {
      background-color: white;
      border-radius: 8px;
      box-shadow: 0 2px 3px rgba(10, 10, 10, 0.1);
      padding: 20px;
    }
    
    .schedule-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    
    .schedule-title {
      margin-bottom: 10px;
    }
    
    .schedule-period {
      font-size: 1rem;
      font-weight: normal;
      color: #666;
      margin-left: 10px;
    }
    
    .schedule-navigation {
      margin-bottom: 10px;
    }
    
    .schedule-info {
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid #eee;
    }
    
    .subject-legend {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 10px;
    }
    
    .subject-legend .tag {
      font-size: 0.7rem;
      height: auto;
      padding: 2px 6px;
      margin-right: 4px;
      margin-bottom: 4px;
    }

    /* Special handling for multi-hour courses */
    .hour-row .course-block {
      opacity: 1;
    }
  </style>
<% end %>

<% content_for :body_class, "schedule-page" %>
<% content_for :title, "Schedule" %>

<div class="schedule-container">
  <div class="schedule-header">
    <div class="schedule-title">
      <h1 class="title is-2">
        <% if current_person.is_a?(Student) %>
          Schedule for <%= current_person.full_name %>
        <% elsif current_person.is_a?(Teacher) %>
          Teaching Schedule
        <% else %>
          School Schedule
        <% end %>
        <span class="schedule-period">— <%= @week_start.strftime("%d %B") %> to <%= @week_end.strftime("%d %B %Y") %></span>
      </h1>
    </div>

    <div class="schedule-navigation">
      <div class="buttons are-small">
        <%= link_to schedules_path(date: @date - 7.days), class: "button is-dark" do %>
          <span class="icon"><i class="fas fa-chevron-left"></i></span>
          <span>Previous</span>
        <% end %>
        <%= link_to schedules_path, class: "button is-primary" do %>
          <span class="icon"><i class="fas fa-calendar-day"></i></span>
          <span>Today</span>
        <% end %>
        <%= link_to schedules_path(date: @date + 7.days), class: "button is-dark" do %>
          <span>Next</span>
          <span class="icon"><i class="fas fa-chevron-right"></i></span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="schedule-info">
    <div class="level">
      <div class="level-left">
        <div class="level-item">
          <div class="tags">
            <% if current_person.is_a?(Student) %>
              <% current_person.school_classes.each do |school_class| %>
                <span class="tag is-info"><%= school_class.name %></span>
              <% end %>
            <% else %>
              <span class="tag is-info">Week <%= @date.strftime("%U").to_i %></span>
            <% end %>
            <span class="tag is-light">Academic Year <%= Time.current.year %></span>
            
            <% if @current_moment %>
              <span class="tag is-success">Current Period: <%= @current_moment.display_name %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
      
    <% if @subject_colors.any? %>
      <div class="dropdown-divider"></div>
      <div class="subject-legend">
        <strong style="color: #333; margin-right: 10px; font-size: 0.75rem;">Subjects:</strong>
        <% @subject_colors.each do |subject_id, color| %>
          <% subject = Subject.find(subject_id) %>
          <span class="tag" style="background-color: <%= color %>; color: white; margin-right: 5px;">
            <%= subject.name %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @courses.any? %>
    <div class="timetable-container">
      <table class="timetable">
        <thead>
          <tr>
            <th class="time-column">Hours</th>
            <% [1, 2, 3, 4, 5].each do |day| %>
              <th class="day-column"><%= @days_of_week[day] %> <%= (@week_start + (day-1).days).strftime("%d.%m") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% (7..20).each do |hour| %>
            <tr class="hour-row">
              <td class="time-cell"><%= sprintf("%02d", hour) %>:00</td>
              <% [1, 2, 3, 4, 5].each do |day| %>
                <td class="day-cell">
                  <% 
                    courses_at_hour = @schedule[day].select do |course| 
                      start_hour = course.start_at.hour
                      end_hour = course.end_at.hour
                      
                      # Check if this hour falls within the course's time range
                      (start_hour <= hour && end_hour > hour) || 
                      (start_hour == hour && end_hour == hour)
                    end
                  %>
                  <% courses_at_hour.each do |course| %>
                    <% 
                      # Get the course color from subject
                      course_color = @subject_colors[course.subject.id]
                    %>
                      <div class="course-block" 
                           style="background-color: <%= course_color %>;"
                           data-subject="<%= course.subject.name %>">
                        <div class="course-header">
                          <div class="course-time">
                            <%= course.start_at.strftime("%H:%M") %> - <%= course.end_at.strftime("%H:%M") %>
                          </div>
                          <% if current_person.is_a?(Student) %>
                            <div class="course-teacher">
                              <%= course.person.full_name.split.first %>
                            </div>
                          <% end %>
                        </div>
                        <div class="course-content">
                          <div class="course-left">
                            <div class="course-name">
                              <%= course.subject.name %>
                            </div>
                            <div class="course-location">
                              <%= course.school_class.name %>
                            </div>
                          </div>
                          <% if course.school_class.room %>
                            <div class="course-right">
                              <%= course.school_class.room.name %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="notification is-info is-light mt-5">
      <p class="has-text-centered">
        <% if current_person.is_a?(Student) %>
          You don't have any courses scheduled.
        <% elsif current_person.is_a?(Teacher) %>
          You don't have any teaching assignments scheduled.
        <% else %>
          No courses have been scheduled.
        <% end %>
      </p>
    </div>
  <% end %>
</div> 