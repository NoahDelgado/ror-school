<% content_for :title, "Courses" %>

<section class="section">
  <div class="container">
    <div class="level mb-5">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Courses</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <% if current_person&.is_a?(Dean) %>
            <%= link_to new_course_path, class: "button is-primary" do %>
              <span class="icon">
                <i class="fas fa-plus"></i>
              </span>
              <span>New Course</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <% if @courses.any? %>
      <div class="card">
        <header class="card-header">
          <p class="card-header-title">
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-list"></i>
              </span>
              <span>All Courses</span>
            </span>
          </p>
        </header>
        <div class="card-content">
          <div class="table-container">
            <table class="table is-fullwidth is-hoverable">
              <thead>
                <tr>
                  <th>Subject</th>
                  <th>Class</th>
                  <th>Teacher</th>
                  <th>Period</th>
                  <th>Schedule</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @courses.each do |course| %>
                  <tr>
                    <td><%= course.subject&.name || "Unknown subject" %></td>
                    <td><%= course.school_class&.name || "Unknown class" %></td>
                    <td><%= course.person&.full_name || "No teacher assigned" %></td>
                    <td><%= course.moment&.display_name || "Unknown period" %></td>
                    <td>
                      <span class="icon-text">
                        <span class="icon">
                          <i class="fas fa-calendar-day"></i>
                        </span>
                        <span>
                          <%= [
                            ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][course.week_day],
                            course.start_at&.strftime("%H:%M"),
                            course.end_at&.strftime("%H:%M")
                          ].compact.join(" | ") %>
                        </span>
                      </span>
                    </td>
                    <td>
                      <div class="buttons are-small">
                        <%= link_to course_path(course), class: "button is-info" do %>
                          <span class="icon">
                            <i class="fas fa-eye"></i>
                          </span>
                          <span>View</span>
                        <% end %>
                        
                        <% if current_person&.is_a?(Dean) %>
                          <%= link_to edit_course_path(course), class: "button is-link" do %>
                            <span class="icon">
                              <i class="fas fa-edit"></i>
                            </span>
                            <span>Edit</span>
                          <% end %>
                          
                          <%= button_to course_path(course), method: :delete, class: "button is-danger", form: { style: "display: inline;" }, data: { turbo_confirm: "Are you sure you want to archive this course?" } do %>
                            <span class="icon">
                              <i class="fas fa-archive"></i>
                            </span>
                            <span>Archive</span>
                          <% end %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% else %>
      <div class="notification is-info is-light">
        <p>No courses have been created yet.</p>
      </div>
    <% end %>
  </div>
</section>
