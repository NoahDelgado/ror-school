<% content_for :title, "Section Details" %>

<section class="section">
  <div class="container">
    <div class="level mb-5">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Section Details</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <%= link_to sections_path, class: "button is-light" do %>
            <span class="icon">
              <i class="fas fa-arrow-left"></i>
            </span>
            <span>Back to Sections</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card">
      <header class="card-header">
        <p class="card-header-title">
          <span class="icon-text">
            <span class="icon">
              <i class="fas fa-project-diagram"></i>
            </span>
            <span><%= @section.name %></span>
          </span>
        </p>
      </header>
      <div class="card-content">
        <div class="content">
          <p class="has-text-weight-bold">Name: <%= @section.name %></p>
        </div>
      </div>
      <footer class="card-footer">
        <% if current_person&.is_a?(Dean) %>
          <%= link_to edit_section_path(@section), class: "card-footer-item" do %>
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-edit"></i>
              </span>
              <span>Edit</span>
            </span>
          <% end %>
          
          <%= button_to section_path(@section), method: :delete, class: "card-footer-item button is-white has-text-danger", data: { turbo_confirm: "Are you sure you want to delete this section?" } do %>
            <span class="icon-text">
              <span class="icon">
                <i class="fas fa-trash"></i>
              </span>
              <span>Delete</span>
            </span>
          <% end %>
        <% end %>
      </footer>
    </div>

    <% if current_person&.is_a?(Dean) %>
      <div class="mt-5">
        <h2 class="subtitle">Classes in This Section</h2>
        <% school_classes = SchoolClass.where(section_id: @section.id) %>
        
        <% if school_classes.any? %>
          <div class="table-container">
            <table class="table is-fullwidth is-hoverable">
              <thead>
                <tr>
                  <th>Class Name</th>
                  <th>Room</th>
                  <th>Academic Period</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% school_classes.each do |school_class| %>
                  <tr>
                    <td><%= school_class.name %></td>
                    <td><%= school_class.room&.name || "-" %></td>
                    <td><%= school_class.moment&.display_name || "-" %></td>
                    <td>
                      <div class="buttons are-small">
                        <%= link_to school_class_path(school_class), class: "button is-info" do %>
                          <span class="icon">
                            <i class="fas fa-eye"></i>
                          </span>
                          <span>View</span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="notification is-info is-light">
            <p>No classes are currently assigned to this section.</p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
