<%= form_with(model: address) do |form| %>
  <% if address.errors.any? %>
    <div class="notification is-danger">
      <h2><%= pluralize(address.errors.count, "error") %> prohibited this address from being saved:</h2>

      <ul>
        <% address.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :zip, class: "label" %>
    <div class="control">
      <%= form.text_field :zip, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= form.label :town, class: "label" %>
    <div class="control">
      <%= form.text_field :town, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= form.label :street, class: "label" %>
    <div class="control">
      <%= form.text_field :street, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= form.label :number, class: "label" %>
    <div class="control">
      <%= form.text_field :number, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= form.submit class: "button is-primary" %>
  </div>
<% end %>
